[sub_resource type="Shader" id="Shader_blur"]
code = "shader_type canvas_item;\nrender_mode unshaded;\n\nuniform sampler2D screen_texture : hint_screen_texture, repeat_disable, filter_linear_mipmap;\nuniform float blur_lod : hint_range(0.0, 6.0) = 4.0;\nuniform vec4 veil : source_color = vec4(0.018, 0.012, 0.045, 0.42);\n\nvoid fragment() {\n\tvec4 scene_color = textureLod(screen_texture, SCREEN_UV, blur_lod);\n\tCOLOR = vec4(mix(scene_color.rgb, veil.rgb, veil.a), 1.0);\n}\n"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_blur"]
shader = SubResource("Shader_blur")

