# Godot generated files
.godot/
/Deleted/
__pycache__/
*.py[cod]

# Export output
builds/
exports/

# Mono / C# generated files
.mono/
data_*/
mono_crash.*.json

# IDEs and editors
.idea/
.vscode/
*.code-workspace

# Operating systems
.DS_Store
Thumbs.db
desktop.ini

# Temporary, QA and backup files
/tmp/
temp/
.docx-review/
*.tmp
*.temp
*.bak
*.blend1
*~

# Local 3D experimentation; only the exported board model is versioned
/assets/models/board/*
!/assets/models/board/queens_trial_board.glb
!/assets/models/board/queens_trial_board_no_star.glb
!/assets/models/board/painter/
/assets/models/pieces/*
!/assets/models/pieces/.gitkeep
!/assets/models/pieces/bispo.glb
!/assets/models/pieces/bispo_sem_textura.glb
!/assets/models/pieces/torre.glb
!/assets/models/pieces/torre_sem_textura.glb
!/assets/models/pieces/animated/
!/assets/models/pieces/bispo_images/
!/assets/models/pieces/bispo_images/.gitkeep

# Generation and prototype files that are not required at runtime
/scripts/effects/
/scripts/pieces/*
!/scripts/pieces/.gitkeep
!/scripts/pieces/piece_visual_animator.gd
!/scripts/pieces/piece_visual_animator.gd.uid
!/scripts/pieces/rook_resolver.gd
!/scripts/pieces/rook_resolver.gd.uid
!/scripts/pieces/enemy_piece_controller.gd
!/scripts/pieces/enemy_piece_controller.gd.uid
# Utilitários locais de preparação, sem dependências no jogo.
/tools/

# Godot sidecars remain versioned because they preserve project-specific import
# settings. Only the generated .godot/ cache above stays local.

# Logs
*.log

# Local Trello credentials and synchronization state
tools/trello/trello.local.ps1
tools/trello/.trello-state.json
